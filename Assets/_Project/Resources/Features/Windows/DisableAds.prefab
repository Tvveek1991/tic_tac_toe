  m_text: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0435\u0449\u0451 \u043D\u0435
    \u0433\u043E\u0442\u043E\u0432 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u044C
    \u043F\u043E\u043B\u043D\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
    \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    2 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0432\u0438\u0434\u0435\u043E\u0440\u043E\u043B\u0438\u043A\u0430
    \u0438 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 24 \u0447\u0430\u0441\u043E\u0432
    \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F, \u043A\u0430\u043A \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u0435\u043D
    \u043C\u0438\u0440 \u0431\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u044B"
